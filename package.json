{
	"name": "the-stack",
	"description": "A Cloudflare Workers app template.",
	"cloudflare": {
		"label": "Cloudflare App Template",
		"products": [
			"Workers"
		],
		"categories": [],
		"publish": true
	},
	"scripts": {
		"local:setup": "node scripts/setup-local.mjs",
		"local:seed": "node scripts/seed-local.mjs",
		"local:reset": "node scripts/reset-local.mjs",
		"admin:create": "pnpm run db:local:migrate && node scripts/create-admin-local.mjs",
		"build": "pnpm run cf:typegen && STACK_BUILD=deploy astro sync && tsc -b && STACK_BUILD=deploy astro build",
		"check": "pnpm run build && wrangler deploy --config dist/server/wrangler.json --dry-run",
		"deploy": "node scripts/deploy.mjs",
		"secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\"",
		"proof": "node scripts/proof.ts",
		"ship": "node scripts/ship.ts",
		"ci:wait": "node scripts/ci-wait.ts",
		"admin:bootstrap": "node scripts/admin-bootstrap.ts",
		"shot": "node scripts/shot.ts",
		"api": "node scripts/api.ts",
		"demo:record": "node scripts/demo-record.ts",
		"example:remove": "node scripts/example-remove.ts",
		"dev": "node scripts/dev-server.ts start",
		"dev:stop": "node scripts/dev-server.ts stop",
		"dev:wait": "node scripts/dev-server.ts wait",
		"doctor": "node scripts/dev-doctor.mjs",
		"status": "node scripts/dev-status.mjs",
		"logs": "node scripts/logs.ts",
		"lint": "oxlint --type-aware --deny-warnings .",
		"routes": "astro sync",
		"routes:new": "node scripts/new-route.mjs",
		"prepare": "husky",
		"test": "tsx --tsconfig tsconfig.app.json --test \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\" \"tests/smoke/**/*.test.ts\"",
		"preview": "astro sync && tsc -b && astro build && node scripts/preview.mjs",
		"email:dev": "email dev",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"test:e2e": "playwright test",
		"verify:fast": "pnpm run lint && pnpm run format:check && astro sync && tsc -b && pnpm run test:types && pnpm test",
		"verify": "pnpm run lint && pnpm run format:check && pnpm run build && pnpm run test:types && pnpm test && pnpm run test:migrations && pnpm run test:tooling",
		"test:types": "tsc -p tsconfig.tests.json",
		"test:tooling": "tsx --tsconfig tsconfig.app.json --test \"tests/tooling/**/*.test.ts\"",
		"test:migrations": "tsx --tsconfig tsconfig.app.json scripts/testing/check-migrations.ts",
		"cf:typegen": "node scripts/generate-types.mjs",
		"db:local:migrate": "node scripts/local-cloudflare.mjs && wrangler d1 migrations apply CORE_DB --local --config .wrangler/local/wrangler.json --persist-to .wrangler/state && wrangler d1 migrations apply TURRET_DB --local --config .wrangler/local/wrangler.json --persist-to .wrangler/state",
		"db:core:generate": "drizzle-kit generate --config src/bindings/d1/core/drizzle.config.ts",
		"db:turret:generate": "drizzle-kit generate --config src/bindings/d1/turret/drizzle.config.ts",
		"db:studio:core": "pnpm run db:local:migrate && node scripts/drizzle-studio-core-local.mjs",
		"db:studio:turret": "pnpm run db:local:migrate && node scripts/drizzle-studio-turret-local.mjs"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.3.3",
		"@astrojs/react": "7.0.0",
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/inter": "5.3.0",
		"@hono/zod-openapi": "^1.6.3",
		"@rrweb/rrweb-plugin-console-record": "^2.1.7",
		"@rrweb/types": "^2.1.7",
		"@scalar/hono-api-reference": "^0.12.9",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-table": "^9.2.5",
		"astro": "7.3.5",
		"better-auth": "~1.7.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"dotenv": "^18.0.5",
		"drizzle-orm": "^0.45.3",
		"evlog": "2.30.0",
		"hono": "^4.13.13",
		"lucide-react": "^1.52.0",
		"react": "^19.3.0",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.0",
		"react-email": "6.11.0",
		"react-resizable-panels": "^4.14.2",
		"recharts": "^3.10.1",
		"resend": "^6.32.0",
		"rrweb": "^2.1.7",
		"rrweb-player": "^2.1.7",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"vaul": "^1.1.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.62.5",
		"@oxlint/plugins": "1.86.0",
		"@playwright/test": "1.63.0",
		"@tanstack/eslint-plugin-query": "^5.104.1",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@tanstack/react-query-devtools": "^5.104.1",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-plugin": "^1.168.42",
		"@types/better-sqlite3": "^9.6.0",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^22.20.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"better-sqlite3": "^13.0.3",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.7",
		"husky": "^9.1.7",
		"jsdom": "^30.1.2",
		"lint-staged": "^17.6.0",
		"oxc-transform-react": "^0.145.0",
		"oxfmt": "^0.71.0",
		"oxlint": "1.86.0",
		"oxlint-tsgolint": "7.0.2004",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "npm:@typescript/typescript6@~6.0.2",
		"vite": "^8.3.2",
		"void": "0.28.0",
		"wrangler": "^4.151.0"
	},
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.21.0"
	},
	"packageManager": "pnpm@10.34.6",
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,json,yml,yaml,md,mdx,astro,css,scss,html}": "oxfmt --no-error-on-unmatched-pattern --write"
	}
}
