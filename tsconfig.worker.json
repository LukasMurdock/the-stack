{
	"extends": "./tsconfig.node.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
		"types": ["vite/client", "./worker-configuration.d.ts"],
		"lib": ["ES2023"],
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/worker", "src/worker.ts", "src/contracts", "src/bindings"],
	"exclude": ["src/bindings/d1/**/drizzle.studio.local.config.ts"]
}
