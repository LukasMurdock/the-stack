# Local development secrets for `wrangler dev` / Cloudflare Vite plugin.
# `pnpm local:setup` copies this file and initializes the local auth secret.
# Non-sensitive local defaults like APP_URL and ADMIN_EMAIL live in wrangler.json vars.

# Better Auth
# Setup generates this automatically for local development. For production:
# npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET="replace-me"

# Used by the one-time bootstrap admin endpoint.
BOOTSTRAP_SECRET=""

# Auth policy
# invite_only (default): signup requires admin provisioning or a live organization invitation.
# open: allow public self-service sign-up.
AUTH_SIGNUP_MODE="invite_only"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email
# Local default EMAIL_TRANSPORT=log sends nothing.
# Set EMAIL_TRANSPORT=resend explicitly to send real local test emails.
# Cloudflare sending uses the EMAIL binding, not an API key.
# See docs/email.md for production setup and local simulation.
RESEND_API_KEY=""

# Turret (optional)
# Signs Turret upload tokens. Only required if you enable Turret ingestion locally.
TURRET_SIGNING_KEY=""

# Turret mode
# full (default): enable ingestion when signing key is present, otherwise degrade to basic.
# basic: disable ingestion endpoints but keep Turret admin/read surfaces available.
# off: disable Turret ingestion entirely.
TURRET_MODE="full"
